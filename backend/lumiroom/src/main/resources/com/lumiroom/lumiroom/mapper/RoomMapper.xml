<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lumiroom.lumiroom.mapper.RoomMapper">

  <select id="getMembersByRoomId" parameterType="string" resultType="com.lumiroom.lumiroom.model.RoomMember">
    SELECT member_id
    FROM public.rooms
    WHERE room_id::text = #{roomId}
  </select>

</mapper>
